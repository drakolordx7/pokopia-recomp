<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline Maxwell -> SPIR-V through Ryujinx's shader translator (MIT). See docs/nvn/TRANSLATOR.md.
       The translator is not vendored: translator/Ryujinx.Graphics.Shader.csproj builds it from the local checkout in
       third_party/ryubing (staged by scripts/setup_ryujinx.ps1), with the patches in translator/ applied to copies of the files they touch. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>spirv_harness</AssemblyName>
    <RootNamespace>SpirvHarness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Many translator threads allocate hard: one GC heap per core, no background GC, no DATAS shrinking the heap count.
         The runtime's on-demand worker caps the heaps with DOTNET_GCHeapCount. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GCDynamicAdaptationMode>0</GCDynamicAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="translator/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="translator/Ryujinx.Graphics.Shader.csproj" />
  </ItemGroup>

</Project>
