+        /// nothing between the assignment and the use can write memory: the use must be a statement of the same block and no
+        /// statement in between may store, run an atomic, call, wait at a barrier or open a block. Otherwise "x = buf[i];
+        /// buf[i] = y; use(x)" read buf[i] after the store (hwcheck: LDG with the address register overwritten afterwards).
+        private static bool MovesMemoryAccess(AstAssignment assignment, AstOperand propVar)
+        {
+            // an atomic or a call is never folded into its use: its assignment stays (HasSideEffects), so folding it ran it twice
+            if (HasSideEffects(assignment.Source))
+            {
+                return true;
+            }
+
+            if (!ReadsMemory(assignment.Source))
+            {
+                return false;
+            }
+
+            if (propVar.Uses.Count != 1)
+            {
+                return true;
+            }
+
+            IAstNode use = propVar.Uses.First();
+
+            if (use.LLNode == null || use.Parent != assignment.Parent || assignment.LLNode == null)
+            {
+                return true;
+            }
+
+            for (LinkedListNode<IAstNode> n = assignment.LLNode.Next; n != null; n = n.Next)
+            {
+                if (n.Value == use)
+                {
+                    return false;
+                }
+
+                if (n.Value is AstBlock || WritesMemory(n.Value))
+                {
+                    return true;
+                }
+            }
+
+            return true;
+        }
+
+        private static bool ReadsMemory(IAstNode node)
+        {
+            if (node is not AstOperation op)
+            {
+                return false;
+            }
+
+            Instruction inst = op.Inst & Instruction.Mask;
+
+            if ((inst == Instruction.Load && IsMutableStorage(op.StorageKind)) || inst == Instruction.ImageLoad ||
+                inst.IsAtomic() || inst == Instruction.ImageAtomic || inst == Instruction.Call)
+            {
+                return true;
+            }
+
+            for (int index = 0; index < op.SourcesCount; index++)
+            {
+                if (ReadsMemory(op.GetSource(index)))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        private static bool WritesMemory(IAstNode node)
+        {
+            if (node is AstAssignment assignment)
+            {
+                node = assignment.Source;
+            }
+
+            if (node is not AstOperation op)
+            {
+                return false;
+            }
+
+            Instruction inst = op.Inst & Instruction.Mask;
+
+            if (inst == Instruction.Store || inst.IsAtomic() || inst.IsImageStore() || inst == Instruction.Call ||
+                inst == Instruction.Barrier || inst == Instruction.GroupMemoryBarrier || inst == Instruction.MemoryBarrier)
+            {
+                return true;
+            }
+
+            for (int index = 0; index < op.SourcesCount; index++)
+            {
+                if (WritesMemory(op.GetSource(index)))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        private static bool IsMutableStorage(StorageKind kind)
+        {
+            return kind is not (StorageKind.None or StorageKind.Input or StorageKind.InputPerPatch or StorageKind.ConstantBuffer);
+        }
+
+        private static bool HasSideEffects(IAstNode source)
+        {
+            return source is AstOperation op && (op.Inst.IsAtomic() || op.Inst == Instruction.Call);
+        }
