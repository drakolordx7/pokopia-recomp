<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hardware oracle for the Ampere front end: runs single SASS instructions on the local NVIDIA GPU (CUDA driver API, patched
       cubin) and the same instructions translated to SPIR-V (spirv_harness hwcheck mode) in Vulkan compute, and compares the
       register files. See README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>hwcheck</AssemblyName>
    <RootNamespace>Hwcheck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ampere/decoder/AmpereDecoder.csproj" />
    <!-- built alongside; run as a separate process (spirv_harness.dll in the same bin folder) -->
    <ProjectReference Include="../harness/SpirvHarness.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="template.ptx;ops.ptx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
